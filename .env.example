# 从 LiveKit Cloud 项目的设置中获取；只填写在 .env.local，不发到聊天中。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 首轮使用 LiveKit Inference，模型用量由 LiveKit 账户计费。
AGENT_NAME=my-agent
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=zh
LLM_MODEL=google/gemma-4-31b-it
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
TTS_LANGUAGE=zh
